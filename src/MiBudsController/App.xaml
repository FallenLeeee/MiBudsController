<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MiBudsController.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MiBudsController">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 导航层透明，云母才能透出；Win10 实色回退由 MainWindow 在运行时处理 -->
            <SolidColorBrush x:Key="NavigationViewDefaultBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />

            <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="20" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="SubtleButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocusedPressed" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#171717" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#171717" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#171717" />
                    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#8C8C8C" />
                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#171717" />
                    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#171717" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#262626" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#333333" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#202020" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#262626" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocusedPressed" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#757575" />
                    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#F2F2F2" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

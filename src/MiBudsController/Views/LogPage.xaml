<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MiBudsController.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MiBudsController.Core.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid Padding="20,16,20,20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="协议日志" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="{x:Bind Vm.CaptureHint, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Text="{x:Bind Vm.LogPath, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                IsTextSelectionEnabled="True"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,10" Orientation="Horizontal" Spacing="8">
            <Button
                Content="{x:Bind Vm.DiskLogButtonText, Mode=OneWay}"
                Command="{x:Bind Vm.ToggleDiskLogCommand}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button Content="清空" Command="{x:Bind Vm.ClearCommand}" />
            <Button Content="复制" Command="{x:Bind Vm.CopyCommand}" />
            <Button Content="复制路径" Command="{x:Bind Vm.CopyLogPathCommand}" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="{x:Bind Vm.EntryCount, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView
                x:Name="LogList"
                ItemsSource="{x:Bind Vm.Entries}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:LogEntry">
                        <Grid Padding="0,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Time}"
                                VerticalAlignment="Top"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <Border
                                Grid.Column="1"
                                Padding="6,1"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                CornerRadius="3"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock
                                    Text="{x:Bind DirectionText}"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind Hex}"
                                VerticalAlignment="Top"
                                FontFamily="Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True" />
                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind Summary}"
                                VerticalAlignment="Top"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6"
                Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}">
                <TextBlock
                    Text="暂无协议日志"
                    Style="{StaticResource BodyTextBlockStyle}"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="开启调试模式并连接耳机后，收发的 RCSP 帧会显示在这里"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

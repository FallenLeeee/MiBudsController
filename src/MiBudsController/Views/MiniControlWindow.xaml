<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MiBudsController.Views.MiniControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiBudsController.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="耳机迷你面板"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Padding="2,0,2,2">
        <Border
            x:Name="PanelCard"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid x:Name="PanelBody">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="DragArea" Padding="12,10,10,4" Row="0">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Main.DeviceDisplayTitle, Mode=OneWay}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind Main.ShowDeviceStatus, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind Main.StatusText, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled">
                    <StackPanel Padding="10,2,10,4" Spacing="8">

                        <Border
                            Padding="8,6"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1" HorizontalAlignment="Center">
                                    <TextBlock Text="左" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="MiniLeftBatteryText" Text="{x:Bind Main.LeftBattery.LevelText, Mode=OneWay}" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Center">
                                    <TextBlock Text="右" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="MiniRightBatteryText" Text="{x:Bind Main.RightBattery.LevelText, Mode=OneWay}" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Center">
                                    <TextBlock Text="盒" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="MiniCaseBatteryText" Text="{x:Bind Main.CaseBattery.LevelText, Mode=OneWay}" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Padding="10,8"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="降噪状态" FontSize="13" FontWeight="SemiBold" />
                                <controls:SegmentedControl
                                    MinHeight="32"
                                    ItemsSource="{x:Bind Noise.NoiseModes}"
                                    SelectedOption="{x:Bind Noise.SelectedNoiseMode, Mode=TwoWay}" />

                                <StackPanel Spacing="4" Visibility="{x:Bind Noise.ShowAncBranch, Mode=OneWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="智能降噪" VerticalAlignment="Center" FontSize="13" />
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            MinWidth="0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind Noise.IsSmartNoiseEnabled, Mode=OneWay}"
                                            IsOn="{x:Bind Noise.SmartNoiseCancelling, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock
                                        Text="{x:Bind Noise.AncLevelText, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider
                                        MinHeight="24"
                                        IsEnabled="{x:Bind Noise.IsAncLevelEnabled, Mode=OneWay}"
                                        Minimum="0"
                                        Maximum="19"
                                        StepFrequency="1"
                                        Value="{x:Bind Noise.AncLevel, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="4" Visibility="{x:Bind Noise.ShowTransparencyBranch, Mode=OneWay}">
                                    <TextBlock Text="通透模式" FontSize="13" />
                                    <controls:SegmentedControl
                                        MinHeight="32"
                                        ItemsSource="{x:Bind Noise.TransparencyPresets}"
                                        SelectedOption="{x:Bind Noise.SelectedTransparencyPreset, Mode=TwoWay}" />
                                </StackPanel>

                                <TextBlock
                                    Text="环境声已关闭"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind Noise.ShowOffHint, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    Grid.Row="2"
                    Padding="10,4,10,10"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Content="主界面"
                        Click="OpenMain_Click" />
                    <Button
                        Content="断开连接"
                        Click="Disconnect_Click"
                        IsEnabled="{x:Bind Main.IsConnected, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

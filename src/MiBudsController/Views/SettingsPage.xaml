<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MiBudsController.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20,16,20,28" MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="启动与托盘 · 连接偏好 · 系统 · 关于"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="启动" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="开机自启" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="登录 Windows 后自动启动，并最小化到系统托盘"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Vm.AutoStart, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="启动时最小化到托盘" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="开机自启或带 --minimized 参数时不弹出主窗口"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Vm.StartMinimized, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="调试" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="调试模式" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="开启后显示「日志」菜单，并在内存中记录协议帧；默认关闭。写入磁盘需在日志页另行开始。"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Vm.DebugMode, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="系统托盘" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="显示托盘图标" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="左键打开迷你控制面板，右键打开菜单"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Vm.ShowTrayIcon, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="关闭主窗口时最小化到托盘" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="应用保留在后台，可从托盘再次打开；退出请用托盘菜单"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Vm.MinimizeToTray, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开迷你面板" Click="OpenMini_Click" />
                        <Button Content="打开托盘图标位置说明" Click="ShowTrayHint_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="连接" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="自动连接" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="断开后尝试自动重连（保存在本机）"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Main.AutoReconnect, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="系统音频路由" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="通话 / 媒体音频 / 输入设备由 Windows 蓝牙设置管理，本应用不提供可写开关。"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <Button Content="打开系统声音设置" Click="OpenWindowsSoundSettings_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardBorderStyle}" Opacity="0.72">
                <StackPanel Spacing="10">
                    <TextBlock Text="通勤沉浸 / 手势操作" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                    <TextBlock
                        Text="对应手机 App 功能，当前控制协议未覆盖，已禁用占位。"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorDisabledBrush}"
                        TextWrapping="Wrap" />
                    <Button Content="打开系统蓝牙设置" Click="OpenBluetoothSettings_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="取消配对" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock
                        Text="请在 Windows 设置 → 蓝牙和其他设备中取消配对。"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="打开蓝牙设置" Click="OpenBluetoothSettings_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Vm.VersionText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock
                        Text="WinUI 3 · Redmi Buds 8 Pro RCSP · 协议见项目 README"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
